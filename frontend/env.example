# Azure Storage Configuration
VITE_AZURE_STORAGE_URL=https://urbanevents.blob.core.windows.net/urbanevents
VITE_AZURE_STORAGE_CONTAINER=urbanevents

# Azure Storage Authentication
# Since your container is already public, use this:
VITE_AZURE_STORAGE_PUBLIC_ACCESS=true

# App Configuration
VITE_APP_NAME=Urban Events
VITE_APP_PRIMARY_COLOR=#4A5262
VITE_APP_SECONDARY_COLOR=#147C74
VITE_APP_FAVICON=/logos/urban-events-icon.svg

# Default Image URL (fallback when no image is available)
VITE_DEFAULT_IMAGE_URL=/images/event-thumb-1.jpg

# API Configuration
VITE_API_URL_CLIENT=http://localhost:8000/api
VITE_API_URL_SERVER=http://localhost:8000/api
VITE_FRONTEND_URL=http://localhost:5678

# Other Configuration
VITE_HIDE_ABOUT_LINK=false
VITE_TOS_URL=
VITE_PRIVACY_URL=
VITE_PLATFORM_SUPPORT_EMAIL=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_CHATWOOT_BASE_URL=
VITE_CHATWOOT_WEBSITE_TOKEN= 
