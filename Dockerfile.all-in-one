# ===============================================
# Stage 1: Build the frontend assets
# ===============================================
FROM node:18-alpine AS node-frontend

WORKDIR /app/frontend

# Copy package.json and yarn.lock first to leverage Docker cache
COPY ./frontend/package.json ./frontend/yarn.lock ./

# Use a separate RUN command for yarn install
RUN yarn install

# Copy the rest of the frontend source code
COPY ./frontend .

# Build the frontend
RUN yarn build

# ===============================================
# Stage 2: Build the PHP Backend and Final Production Image
# ===============================================
FROM serversideup/php:beta-8.3.2-fpm-alpine AS final

# Create a non-root user and switch to it for security
RUN adduser -D -u 1000 myuser
USER myuser

# Install only necessary runtime dependencies
RUN apk add --no-cache nginx supervisor redis dos2unix \
    && install-php-extensions intl pdo_pgsql redis gd

# Set the working directory for the application
WORKDIR /app

# Copy the static assets from the frontend build stage.
COPY --from=node-frontend --chown=myuser:myuser /app/frontend/build /app/frontend

# Copy composer files for caching and install dependencies
COPY --chown=myuser:myuser ./backend/composer.json ./backend/composer.lock ./backend/
RUN composer install --working-dir=/app/backend \
    --no-interaction \
    --no-scripts \
    --no-dev \
    --optimize-autoloader \
    --prefer-dist

# Copy the rest of the backend application code
COPY --chown=myuser:myuser ./backend /app/backend

# Run composer scripts AFTER all code is in place
RUN composer --working-dir=/app/backend run-script post-install-cmd --no-dev

# Set correct permissions
RUN mkdir -p /app/backend/bootstrap/cache \
    && mkdir -p /app/backend/storage \
    && chown -R myuser:myuser /app/backend \
    && chmod -R 775 /app/backend/storage /app/backend/bootstrap/cache \
    && chmod -R 755 /app/backend/vendor/ezyang/htmlpurifier/library/HTMLPurifier/DefinitionCache/Serializer

# Copy configuration files
COPY ./docker/all-in-one/nginx/nginx.conf /etc/nginx/nginx.conf
COPY ./docker/all-in-one/supervisor/supervisord.conf /etc/supervisord.conf

# Copy and prepare startup script
COPY ./docker/all-in-one/scripts/startup.sh /startup.sh
RUN chmod +x /startup.sh

# Expose the port
EXPOSE 80

# Define a health check for the container
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Set the container's command
CMD ["/startup.sh"]
