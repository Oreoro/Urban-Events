FROM node:22-alpine AS node-frontend

WORKDIR /app/frontend

RUN apk add --no-cache yarn

# Increase network timeout for slow ARM emulation builds
RUN yarn config set network-timeout 600000

COPY ./frontend/package.json ./frontend/yarn.lock ./

COPY ./frontend .
COPY ./VERSION /app/VERSION

RUN yarn install --network-timeout 600000 --frozen-lockfile && yarn build

# Use stable multi-arch serversideup/php image
FROM serversideup/php:8.5-fpm-alpine

# Switch to root for installing extensions and packages
USER root

RUN install-php-extensions intl gd pdo_pgsql pgsql sodium curl mbstring xml zip bcmath redis opcache pcntl tokenizer

RUN apk add --no-cache nodejs yarn nginx supervisor redis dos2unix ca-certificates libpng-dev libjpeg-turbo-dev freetype-dev oniguruma-dev libxml2-dev libpq-dev

COPY --from=node-frontend /app/frontend /app/frontend

COPY ./backend /app/backend
COPY ./VERSION /app/backend/VERSION
RUN mkdir -p /app/backend/bootstrap/cache \
    && mkdir -p /app/backend/storage \
    && composer install --working-dir=/app/backend \
        --ignore-platform-reqs \
        --no-interaction \
        --no-dev \
        --optimize-autoloader \
        --prefer-dist \
    && chown -R www-data:www-data \
        /app/backend/storage \
        /app/backend/bootstrap/cache \
        /app/backend/vendor/ezyang/htmlpurifier/library/HTMLPurifier/DefinitionCache/Serializer \
    && find \
        /app/backend/storage \
        /app/backend/bootstrap/cache \
        /app/backend/vendor/ezyang/htmlpurifier/library/HTMLPurifier/DefinitionCache/Serializer \
        -type d -exec chmod 775 {} \; \
    && find \
        /app/backend/storage \
        /app/backend/bootstrap/cache \
        /app/backend/vendor/ezyang/htmlpurifier/library/HTMLPurifier/DefinitionCache/Serializer \
        -type f -exec chmod 664 {} \;

# Copy optimized Nginx config
COPY ./docker/all-in-one/nginx/nginx.conf /etc/nginx/nginx.conf

# Copy Supervisor config
COPY ./docker/all-in-one/supervisor/supervisord.conf /etc/supervisord.conf

# Copy PHP-FPM pool config (tuned workers) + OPcache + runtime settings
COPY ./docker/all-in-one/php/www.conf /usr/local/etc/php-fpm.d/zz-www.conf
COPY ./docker/all-in-one/php/opcache.ini /usr/local/etc/php/conf.d/opcache.ini
COPY ./docker/all-in-one/php/php-custom.ini /usr/local/etc/php/conf.d/custom.ini

# Create OPcache file cache directory and nginx cache directory
RUN mkdir -p /tmp/opcache /tmp/nginx-fcgi-cache /run/nginx \
    && chown -R www-data:www-data /tmp/opcache /tmp/nginx-fcgi-cache /run/nginx

# Copy startup script
COPY ./docker/all-in-one/scripts/startup.sh /startup.sh
RUN dos2unix /startup.sh && chmod +x /startup.sh

EXPOSE 80

WORKDIR /app

CMD ["/startup.sh"]
