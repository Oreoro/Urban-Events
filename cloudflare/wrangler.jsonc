{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "urban-events-app",
  "account_id": "6ddd824137231b85fd268c2bfa3f0c7f",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "APP_ORIGIN": "https://app.urbanevents.pk",
    "CONTAINER_RUNTIME_BUDGET_HOURS": "400"
  },
  "secrets": {
    "required": ["APP_SECRETS_JSON"]
  },
  "containers": [
    {
      "class_name": "UrbanEventsContainer",
      "image": "../Dockerfile.all-in-one",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "URBAN_EVENTS",
        "class_name": "UrbanEventsContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UrbanEventsContainer"]
    }
  ],
  "triggers": {
    "crons": ["7 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
