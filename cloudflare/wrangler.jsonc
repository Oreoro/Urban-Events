{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "urban-events-app",
  "account_id": "6ddd824137231b85fd268c2bfa3f0c7f",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "app.urbanevents.pk",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://app.urbanevents.pk",
    "CONTAINER_RUNTIME_BUDGET_HOURS": "400"
  },
  "secrets": {
    "required": ["APP_SECRETS_JSON"]
  },
  "containers": [
    // Single-instance all-in-one container; embedded Redis (loopback) backs
    // Laravel cache and queues. See docker/all-in-one/supervisor/supervisord.conf.
    {
      "class_name": "UrbanEventsContainer",
      "image": "../Dockerfile.all-in-one",
      "instance_type": "standard-1",
      "max_instances": 1,
      "authorized_keys": [
        {
          "name": "buffy-ssh",
          "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAXvbThfO8I1dWXDmSf/IMEYRap31FEpNMFdKsOqCSCK cloudchamber@urban-events"
        }
      ]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "URBAN_EVENTS",
        "class_name": "UrbanEventsContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UrbanEventsContainer"]
    }
  ],
  "triggers": {
    "crons": ["7 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
